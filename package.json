{
  "name": "whatsapp-drama-shorts",
  "version": "0.1.0",
  "private": true,
  "description": "Generate dramatic WhatsApp-style conversations and record them as vertical short videos for YouTube Shorts and Instagram Reels.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "tsx src/cli.ts generate",
    "render": "tsx src/cli.ts render",
    "shoot": "tsx src/cli.ts shoot",
    "serve": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
